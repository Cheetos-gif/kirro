# Local state and secrets must never enter the image: `COPY . .` would otherwise bake .env (real
# credentials), the local venv, and logs/mock.db (mock state) into a published layer.
.git
.env
.env.*
!.env.example
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
logs/

# Not needed at runtime.
docs/
k8s/
tests/
.claude/
.github/
.pre-commit-config.yaml
*.md
kirro.png

# The portal is a separate application with its own image (web/Dockerfile) and is deployed to
# Vercel; nothing in mock_server, voice_bridge or allocator_bridge imports it. Excluding it keeps
# the mock image small and stops the web build context (node_modules) from bloating this one.
web/

# Compose/Make and the dev image are host tooling, not image content. gunicorn.conf.py is
# deliberately NOT excluded: the production CMD reads it.
Dockerfile.dev
docker-compose.yml
docker-compose.override.yml
Makefile
.vercel
data/
