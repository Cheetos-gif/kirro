# Copy to .env.local and fill in. All server-side: the portal calls mock_server from Vercel
# functions, never from the browser, so none of these are NEXT_PUBLIC_.

# Base URL of the KIRRO mock server. Local default: http://127.0.0.1:8081
MOCK_API_URL=http://127.0.0.1:8081

# Which mock run the portal reads and writes. "default" shares the AgenticOrg agent's run.
MOCK_RUN_ID=default

# The voice bridge's LiveKit room (ADR-017). Local default: ws://127.0.0.1:7880
# (livekit-server --dev prints a dev key pair to use here).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Comma-separated Google emails granted the admin role. Not stored in the mock.
ADMIN_EMAILS=

# Auth.js (Google OAuth). Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
