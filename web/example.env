# KIRRO Core base URL. Internal/server-only — never exposed to the browser.
KIRRO_API_URL=http://localhost:8080

# Auth.js — generate with `npx auth secret`. Gate exists to keep /dashboard off anonymous/bot
# traffic, not to restrict which people may view it (the dashboard is read-only, no risky action
# lives behind it) — any Google account that signs in is let through.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
