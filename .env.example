# Copy to .env. Never commit .env. No real values belong in this file.

# --- Local LLM runner (Anthropic SDK). Only needed for live eval mode. ---
ANTHROPIC_API_KEY=
KIRRO_MODEL=claude-sonnet-5-5

# --- Service URLs ---
KIRRO_CORE_URL=http://localhost:8080
MOCK_SERVER_URL=http://localhost:8081
MOCK_LOG_DIR=logs/mock

# --- Connector modes (see config/connectors.yaml): mock | real ---
PINE_LABS_MODE=mock
GNANI_MODE=mock
DELHIVERY_MODE=mock

# --- Pine Labs P3P sandbox (server SDK: pinelabs-online-p3p-server-sdk) ---
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MERCHANT_ID=
GRANTEX_AGENT_ID=
GRANTEX_API_KEY=

# --- Gnani Inya platform ---
GNANI_INYA_BASE_URL=https://api.inya.ai/platform
GNANI_INYA_API_KEY=
GNANI_AGENT_ID=
# Gnani Vachana speech APIs (fallback voice path only)
GNANI_VACHANA_API_KEY_ID=

# --- Delhivery (staging key only; the demo uses the mock) ---
DELHIVERY_API_TOKEN=
