# Copy to .env. Never commit .env. No real values belong in this file.

# --- Mock server (local dev; the cluster sets its own values in k8s/deployments.yaml) ---
# URL clients (and scripts/dev.sh) use to reach the mock server. The port the server actually binds is
# the `--port` argument (8081 in the Dockerfile, k8s manifest and scripts/dev.sh), not this variable.
MOCK_SERVER_URL=http://localhost:8081
# Directory the mock server writes its per-run request logs to (read by mock_server/state.py).
MOCK_LOG_DIR=logs/mock
# SQLite file holding the mock's state — declare pool, holds, mandates, payments and the idempotency
# ledger (ADR-013). Defaults to <MOCK_LOG_DIR>/mock.db when unset; the cluster points it at the PVC.
MOCK_DB_PATH=logs/mock/mock.db
# Host header allow-list for the MCP endpoints (ADR-012). MCP rejects requests whose Host is not
# listed (421), and the default list assumes localhost — behind a public hostname this must be set.
MOCK_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,api-kirro.upayan.dev

# Optional real Pine Labs Plural UAT call-out (ADR-019). Leave all three unset — the default, and
# every offline test — and the mock's capture/execute and refund stay pure simulation, exactly as
# before. Set PINELABS_CLIENT_ID/SECRET (from https://dashboardv2.pluralonline.com -> Settings ->
# API Keys, free UAT signup, no real money) to also place a real sandbox order/refund alongside
# the mock's own mandate bookkeeping, which remains the source of truth either way.
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in

# Other vendor credentials (Vachana, Twilio, AgenticOrg, WhatsApp) are registered on the AgenticOrg
# platform, not configured from this repo — see docs/agenticorg/setup-runbook.md section 8.
